# Copy to .env.real for real-AWS steps (HealthLake store, import, query).
# Do NOT set AWS_ENDPOINT_URL here -- HealthLake is a real managed service,
# never available on floci. Leave endpoint unset so boto3 hits real AWS.
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=health-fhir-demo-real
HEALTHLAKE_DATASTORE_NAME=ke-health-demo
HEALTHLAKE_MODE=real
