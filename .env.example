# Copy to .env for floci (local emulator) use:
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=health-fhir-demo

# HEALTHLAKE_MODE controls the query layer / demo UI:
#   mock -> return canned fixture data, no AWS calls needed at all
#   real -> call the real AWS HealthLake data store (see .env.real)
HEALTHLAKE_MODE=mock
