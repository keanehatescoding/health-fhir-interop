        <mxCell id="src2" value="Facility B / AKUH (JSON)&#10;keyed on mrn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="180" height="60" as="geometry" />
